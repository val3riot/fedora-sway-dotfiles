[global]
    monitor = 0
    follow = mouse

    width = 360
    height = 140

    origin = top-right
    offset = 12x42

    notification_limit = 4

    font = JetBrainsMono Nerd Font 10

    frame_width = 2
    frame_color = "#7aa2d6"

    separator_height = 2
    separator_color = frame

    padding = 12
    horizontal_padding = 14

    corner_radius = 10

    transparency = 6

    background = "#16181d"
    foreground = "#d8dee9"

    timeout = 5

    icon_position = left
    min_icon_size = 32
    max_icon_size = 48

    markup = full
    format = "<b>%s</b>\n%b"

    sort = yes
    stack_duplicates = true
    hide_duplicate_count = false

    show_age_threshold = 60
    word_wrap = yes

    mouse_left_click = close_current
    mouse_right_click = do_action
    mouse_middle_click = close_all

[urgency_low]
    background = "#16181d"
    foreground = "#9aa3b2"
    frame_color = "#303641"
    timeout = 3

[urgency_normal]
    background = "#16181d"
    foreground = "#d8dee9"
    frame_color = "#7aa2d6"
    timeout = 5

[urgency_critical]
    background = "#16181d"
    foreground = "#ffffff"
    frame_color = "#d16d7a"
    timeout = 0
