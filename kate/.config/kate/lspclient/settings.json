{
  "servers": {
    "java": {
      "command": [
        "@PYTHON@",
        "@LAUNCHER@",
        "java"
      ],
      "rootIndicationFileNames": [
        "pom.xml",
        "build.gradle",
        "build.gradle.kts",
        "settings.gradle",
        "settings.gradle.kts",
        ".git"
      ],
      "useWorkspace": false
    },
    "javascript": {
      "command": [
        "@PYTHON@",
        "@LAUNCHER@",
        "typescript"
      ],
      "rootIndicationFileNames": [
        "package.json",
        "tsconfig.json",
        ".git"
      ],
      "initializationOptions": {
        "plugins": [
          {
            "name": "@angular/language-service",
            "location": "@KATE_TOOLS@/node_modules",
            "languages": [
              "typescript"
            ]
          }
        ]
      }
    },
    "html": {
      "command": [
        "@PYTHON@",
        "@LAUNCHER@",
        "html"
      ],
      "rootIndicationFileNames": [
        "angular.json",
        "package.json",
        ".git"
      ]
    },
    "css": {
      "command": [
        "@PYTHON@",
        "@LAUNCHER@",
        "css"
      ],
      "rootIndicationFileNames": [
        "package.json",
        ".git"
      ]
    },
    "json": {
      "command": [
        "@PYTHON@",
        "@LAUNCHER@",
        "json"
      ],
      "rootIndicationFileNames": [
        "package.json",
        ".git"
      ]
    }
  }
}
